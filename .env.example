# Solana cluster configuration (defaults to devnet)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional companion yt-dlp extraction worker URL (when deployed outside local runtime)
# Leave unset to use built-in pure-JS cloud extractors + automatic local yt-dlp binary detection
PINEREEL_YTDLP_WORKER_URL=
PINEREEL_YTDLP_WORKER_TOKEN=

